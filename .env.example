# Synthetic local-only inputs. Copy to .env; never reuse these values elsewhere.
SIGNALDESK_POSTGRES_DB=signaldesk
SIGNALDESK_POSTGRES_USER=signaldesk_app
SIGNALDESK_POSTGRES_PASSWORD=local-only-postgres-password-2026

SIGNALDESK_WEB_BFF_SERVICE_CREDENTIAL=local-only-web-bff-credential-000000000001
SIGNALDESK_DIAGNOSTIC_WORKER_SERVICE_CREDENTIAL=local-only-diagnostic-worker-credential-000002
SIGNALDESK_EMAIL_WORKER_SERVICE_CREDENTIAL=local-only-email-worker-credential-000000003
SIGNALDESK_EXPORT_WORKER_SERVICE_CREDENTIAL=local-only-export-worker-credential-00000004

SIGNALDESK_WEB_FLASK_SECRET_KEY=local-only-current-flask-signing-key-00000005
SIGNALDESK_WEB_FLASK_SECRET_KEY_FALLBACKS=["local-only-fallback-flask-signing-key-000006"]
SIGNALDESK_SEED_USER_PASSWORD=SignalDesk-local-users-only-2026

MINIO_ROOT_USER=signaldesk-local-root
MINIO_ROOT_PASSWORD=local-only-minio-root-password-00000007
MINIO_EXPORT_WORKER_ACCESS_KEY=signaldesk-export-worker
MINIO_EXPORT_WORKER_SECRET_KEY=local-only-minio-export-secret-00000008

SIGNALDESK_WEB_PORT=8080
