{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyExportPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::signaldesk-exports"],
      "Condition": {
        "StringLike": {"s3:prefix": ["exports", "exports/*"]}
      }
    },
    {
      "Sid": "ImmutableExportReadCreate",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::signaldesk-exports/exports/*"]
    }
  ]
}
